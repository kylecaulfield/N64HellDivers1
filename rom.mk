# ROM build. Invoked by the top-level Makefile with N64_INST pointing at the
# SDK built from the pinned submodules (build/sdk). Not meant to be run directly.

PROJECT   ?= hivebreakers
BUILD_DIR ?= build/rom
SOURCE_DIR = src
FS_DIR    = build/filesystem
GEN_DIR   = build/gen

LIBDRAGON_PREVIEW = 2
N64_MKDFS_ROOT = $(FS_DIR)

include $(N64_INST)/include/n64.mk
include $(N64_INST)/include/t3d.mk

N64_ROM_TITLE = "HIVEBREAKERS"
N64_ROM_EXPANSIONPAK = required
N64_ROM_SAVETYPE = eeprom4k   # high scores and settings (the EverDrive reads this from the header)
N64_ROM_REGIONFREE = 1

# libdragon/Tiny3D headers are third-party: -isystem keeps our -Wextra from
# failing the build on warnings inside them (GCC drops the matching -I).
N64_CFLAGS += -std=gnu17 -Wall -Wextra -Werror -Wshadow -Wdouble-promotion \
              -ffp-contract=off -isystem $(N64_INCLUDEDIR) \
              -Isrc/sim -Isrc/n64 -I$(BUILD_DIR)/gen

ifeq ($(AUTOTEST),1)
N64_CFLAGS += -DAUTOTEST
endif
ifeq ($(BENCH),1)
N64_CFLAGS += -DBENCH_AT_BOOT
endif

SRC := $(wildcard src/sim/*.c) $(wildcard src/n64/*.c)
OBJ := $(SRC:src/%.c=$(BUILD_DIR)/%.o)

# --- Models -----------------------------------------------------------------
# Every model has a generated placeholder. A file in assets/models/<name>.glb
# (e.g. a Blender/Fast64 export) replaces it with no other changes.
MODELS := soldier skitter gnasher bulwark dropship beacon turret crate mgcase pod rock_a rock_b rock_c ground shadow \
          nest nest_dead terminal ground_ash ground_frost rock_a_ash rock_b_ash rock_c_ash \
          rock_a_frost rock_b_frost rock_c_frost
model_src = $(if $(wildcard assets/models/$(1).glb),assets/models/$(1).glb,$(GEN_DIR)/$(1).glb)
MODEL_T3DM := $(MODELS:%=$(FS_DIR)/models/%.t3dm)

$(GEN_DIR)/%.glb: tools/genmodels.py
	@mkdir -p $(dir $@)
	python3 tools/genmodels.py $(GEN_DIR) $*
	@touch $@

.SECONDEXPANSION:
$(FS_DIR)/models/%.t3dm: $$(call model_src,$$*)
	@mkdir -p $(dir $@)
	@echo "    [T3D-MODEL] $@ <- $<"
	$(T3D_GLTF_TO_3D) "$<" $@ --asset-path=assets
	$(N64_BINDIR)/mkasset -c 1 -o $(dir $@) $@

# --- Music, sound effects and 2D art -----------------------------------------
# All generated by tools/genaudio.py and tools/genart.py (original, synthesized
# and drawn there). A file in assets/music/<name>.xm or assets/sfx/<name>.wav
# replaces the generated one, like the models.
MUSIC := title mission hold victory defeat
SFX   := rifle shotgun mg explosion impact bug_hit armor_hit bug_die player_hurt player_die \
         dry_fire reload code_beep code_reject beacon incoming pickup zone menu_move menu_select \
         radio alarm
MUSIC_XM64 := $(MUSIC:%=$(FS_DIR)/music/%.xm64)
SFX_WAV64  := $(SFX:%=$(FS_DIR)/sfx/%.wav64)
ART        := $(FS_DIR)/hive.font64 $(FS_DIR)/logo.sprite $(FS_DIR)/planet.sprite \
              $(FS_DIR)/planet_ash.sprite $(FS_DIR)/planet_frost.sprite

# Each generator writes all its files at once; the stamp stands for them.
$(GEN_DIR)/audio.stamp: tools/genaudio.py
	@mkdir -p $(GEN_DIR)/audio
	python3 tools/genaudio.py $(GEN_DIR)/audio
	@touch $@
$(GEN_DIR)/audio/%: $(GEN_DIR)/audio.stamp ;

$(GEN_DIR)/art.stamp: tools/genart.py
	@mkdir -p $(GEN_DIR)/art
	python3 tools/genart.py $(GEN_DIR)/art
	@touch $@
$(GEN_DIR)/art/%: $(GEN_DIR)/art.stamp ;

music_src = $(if $(wildcard assets/music/$(1).xm),assets/music/$(1).xm,$(GEN_DIR)/audio/music/$(1).xm)
sfx_src = $(if $(wildcard assets/sfx/$(1).wav),assets/sfx/$(1).wav,$(GEN_DIR)/audio/sfx/$(1).wav)

$(FS_DIR)/music/%.xm64: $$(call music_src,$$*)
	@mkdir -p $(dir $@)
	@echo "    [AUDIO] $@ <- $<"
	$(N64_AUDIOCONV) -o $(dir $@) "$<"

$(FS_DIR)/sfx/%.wav64: $$(call sfx_src,$$*)
	@mkdir -p $(dir $@)
	@echo "    [AUDIO] $@ <- $<"
	$(N64_AUDIOCONV) --wav-compress 1 -o $(dir $@) "$<"

$(FS_DIR)/hive.font64: $(GEN_DIR)/art/hive.fnt $(GEN_DIR)/art/hive_0.png
	@mkdir -p $(dir $@)
	@echo "    [FONT] $@"
	$(N64_MKFONT) -o $(dir $@) "$<"

$(FS_DIR)/%.sprite: $(GEN_DIR)/art/%.png
	@mkdir -p $(dir $@)
	@echo "    [SPRITE] $@"
	$(N64_MKSPRITE) -f RGBA16 -o $(dir $@) "$<"

# --- Version stamp (rewritten only when it changes) --------------------------
VERSION := $(shell git describe --always --dirty --abbrev=8 2>/dev/null || echo unknown)
BUILD_DATE := $(shell date -u +%Y-%m-%d)

$(BUILD_DIR)/gen/build_info.h: FORCE
	@mkdir -p $(dir $@)
	@printf '#define GAME_VERSION "%s"\n#define GAME_BUILD_DATE "%s"\n' "$(VERSION)" "$(BUILD_DATE)" > $@.tmp
	@if cmp -s $@.tmp $@; then rm $@.tmp; else mv $@.tmp $@; fi

$(OBJ): $(BUILD_DIR)/gen/build_info.h

# --- ROM --------------------------------------------------------------------
all: $(PROJECT).z64

$(BUILD_DIR)/$(PROJECT).dfs: $(MODEL_T3DM) $(MUSIC_XM64) $(SFX_WAV64) $(ART)
$(BUILD_DIR)/$(PROJECT).elf: $(OBJ)
$(PROJECT).z64: $(BUILD_DIR)/$(PROJECT).dfs

FORCE:
.PHONY: all FORCE
# Keep generated sources (build/gen): make would otherwise delete them as
# intermediates, and the generator stamps would then never rebuild them.
.SECONDARY:
.DEFAULT_GOAL := all

-include $(wildcard $(BUILD_DIR)/*/*.d)
